import { validarEpi } from '../service/crud-validation';
import { ChangeDetectorRef, Component, OnInit, inject } from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule, NgForm } from '@angular/forms';
import { Router } from '@angular/router';
import { ToastService } from '../service/toast.service';
import { EpisService, Epi, EntregaEpi, EntregaEpiRequest } from '../service/epis.service';
import { ColaboradorService } from '../service/colaborador.service';
import { Colaborador } from '../models/colaborador.model';
import { finalize } from 'rxjs';
import { mensagemErroApi } from '../service/api-error';

@Component({
  selector: 'app-epis',
  standalone: true,
  imports: [CommonModule, FormsModule],
  templateUrl: './epis.html',
  styleUrls: ['./epis.scss'],
})
export class Epis implements OnInit {
  private router = inject(Router);
  private toast = inject(ToastService);
  private api = inject(EpisService);
  private apiColaboradores = inject(ColaboradorService);
  private cdr = inject(ChangeDetectorRef);
  erro = '';
  carregando = false;
  salvando = false;
  carregandoEntregas = false;
  ngOnInit() {
    this.carregar();
  }
  carregar() {
    if (this.carregando) return;
    this.carregando = true;
    this.erro = '';
    this.api
      .obterEpis()
      .pipe(
        finalize(() => {
          this.carregando = false;
          this.cdr.markForCheck();
        }),
      )
      .subscribe({
        next: (items) => (this.epis = items),
        error: (e) => (this.erro = mensagemErroApi(e)),
      });
  }

  carregarEntregas() {
    if (this.carregandoEntregas) return;
    this.carregandoEntregas = true;
    this.api
      .obterEntregas()
      .pipe(
        finalize(() => {
          this.carregandoEntregas = false;
          this.cdr.markForCheck();
        }),
      )
      .subscribe({
        next: (items) => (this.entregas = items),
        error: (e) => (this.erro = mensagemErroApi(e)),
      });
  }

  carregarColaboradores() {
    this.apiColaboradores.listar().subscribe({
      next: (items) => {
        this.colaboradores = items;
        this.cdr.markForCheck();
      },
      error: (e) => (this.erro = mensagemErroApi(e)),
    });
  }

  /** Recarrega estoque e entregas: usado pelo botão "Atualizar lista". */
  atualizarListas() {
    this.carregar();
    this.carregarEntregas();
  }

  termoBusca: string = '';

  get listaEpisCadastrados() {
    return this.epis.map((e) => e.descricao);
  }

  get listaColaboradoresCadastrados() {
    return this.colaboradores.map((c) => c.nome);
  }

  epis: Epi[] = [];

  colaboradores: Colaborador[] = [];

  entregas: EntregaEpi[] = [];

  mostrarModalEdicao = false;
  epiEmEdicao: Epi = { id: 0, descricao: '', quantidade: 0, inclusao: '', validade: '', ca: '' };

  abrirModalEdicao(epi: Epi) {
    if (this.salvando) return;
    this.salvando = true;
    this.erro = '';
    this.api
      .obterEpiPorId(epi.id)
      .pipe(
        finalize(() => {
          this.salvando = false;
          this.cdr.markForCheck();
        }),
      )
      .subscribe({
        next: (item) => {
          this.epiEmEdicao = { ...item };
          this.mostrarModalEdicao = true;
        },
        error: (e) => {
          this.erro = mensagemErroApi(e);
          this.toast.error(this.erro);
        },
      });
  }

  fecharModalEdicao() {
    if (this.salvando) return;
    this.mostrarModalEdicao = false;
  }

  salvarEdicao(form?: NgForm) {
    if (this.salvando) return;
    const d = this.epiEmEdicao;
    if (form?.invalid || !validarEpi(d)) {
      form?.control.markAllAsTouched();
      this.toast.error('Preencha os campos e uma quantidade inteira não negativa.');
      return;
    }
    const { id, ...dados } = d;
    this.salvando = true;
    this.erro = '';
    this.api
      .atualizarEpi(id, dados)
      .pipe(
        finalize(() => {
          this.salvando = false;
          this.cdr.markForCheck();
        }),
      )
      .subscribe({
        next: (item) => {
          this.epis = this.epis.map((e) => (e.id === id ? item : e));
          this.mostrarModalEdicao = false;
          this.toast.success('EPI atualizado com sucesso!');
        },
        error: (e) => {
          this.erro = mensagemErroApi(e);
          this.toast.error(this.erro);
        },
      });
  }

  filtrarApenasNumerosCa(event: Event): void {
    const input = event.target as HTMLInputElement;
    if (input) {
      input.value = input.value.replace(/[^0-9]/g, '').slice(0, 10);
      this.epiEmEdicao.ca = input.value;
    }
  }

  mostrarModalEntrega = false;
  novaEntrega = { colaborador: '', epiId: '', data: '', quantidade: 1 };

  abrirModalEntrega() {
    this.novaEntrega = {
      colaborador: '',
      epiId: '',
      data: new Date().toISOString().split('T')[0],
      quantidade: 1,
    };
    this.mostrarModalEntrega = true;
    // Carrega os colaboradores só quando o modal abre, para resolver o nome digitado em um id.
    this.carregarColaboradores();
  }

  fecharModalEntrega() {
    this.mostrarModalEntrega = false;
  }

  /** Registra a entrega na API (abate o estoque no servidor) e recarrega estoque e entregas. */
  salvarEntrega() {
    if (this.salvando) return;
    const nome = this.novaEntrega.colaborador.trim().toLowerCase();
    const colaborador = this.colaboradores.find(
      (c) => c.nome.trim().toLowerCase() === nome || c.matricula.trim().toLowerCase() === nome,
    );
    const epiId = Number(this.novaEntrega.epiId);
    const quantidade = Number(this.novaEntrega.quantidade);
    if (
      !colaborador ||
      !Number.isInteger(epiId) ||
      epiId <= 0 ||
      !Number.isInteger(quantidade) ||
      quantidade <= 0 ||
      !this.novaEntrega.data
    ) {
      this.toast.error(
        'Selecione um colaborador cadastrado, o EPI, uma quantidade inteira maior que zero e a data.',
      );
      return;
    }
    const dados: EntregaEpiRequest = {
      colaboradorId: colaborador.id,
      epiId,
      quantidade,
      dataEntrega: this.novaEntrega.data,
      assinatura: colaborador.nome,
    };
    this.salvando = true;
    this.erro = '';
    this.api
      .registrarEntrega(dados)
      .pipe(
        finalize(() => {
          this.salvando = false;
          this.cdr.markForCheck();
        }),
      )
      .subscribe({
        next: () => {
          this.mostrarModalEntrega = false;
          this.toast.success('Entrega registrada e estoque atualizado!');
          this.carregar();
          this.carregarEntregas();
        },
        error: (e) => {
          this.erro = mensagemErroApi(e);
          this.toast.error(this.erro);
        },
      });
  }

  /** Exclui a entrega (a API estorna a quantidade ao estoque) e recarrega as listas. */
  excluirEntrega(entrega: EntregaEpi) {
    if (
      this.salvando ||
      !window.confirm(`Excluir a entrega de "${entrega.epi}"? O estoque será estornado.`)
    )
      return;
    this.salvando = true;
    this.erro = '';
    this.api
      .excluirEntrega(entrega.id)
      .pipe(
        finalize(() => {
          this.salvando = false;
          this.cdr.markForCheck();
        }),
      )
      .subscribe({
        next: () => {
          this.toast.success('Entrega excluída e estoque estornado!');
          this.carregar();
          this.carregarEntregas();
        },
        error: (e) => {
          this.erro = mensagemErroApi(e);
          this.toast.error(this.erro);
        },
      });
  }

  get episFiltrados(): Epi[] {
    if (!this.termoBusca) return this.epis;
    const termo = this.termoBusca.toLowerCase();
    return this.epis.filter(
      (e) =>
        e.descricao.toLowerCase().includes(termo) ||
        String(e.id).toLowerCase().includes(termo) ||
        e.ca.includes(termo),
    );
  }

  actionNovoEPI(): void {
    this.router.navigate(['/cadastramentos'], { queryParams: { aba: 'epi' } });
  }
  excluir(item: Epi) {
    if (
      this.salvando ||
      !window.confirm(`Excluir "${item.descricao}"? Esta ação não pode ser desfeita.`)
    )
      return;
    this.salvando = true;
    this.erro = '';
    this.api
      .excluirEpi(item.id)
      .pipe(
        finalize(() => {
          this.salvando = false;
          this.cdr.markForCheck();
        }),
      )
      .subscribe({
        next: () => {
          this.epis = this.epis.filter((r) => r.id !== item.id);
          this.toast.success('Registro excluído com sucesso!');
        },
        error: (e) => {
          this.erro = mensagemErroApi(e);
          this.toast.error(this.erro);
        },
      });
  }
}
</file>

<file path="src/app/tela-matriz-treinamento/matriz-treinamento.html">
<div class="matriz-container">
  @if (carregando) {
    <p role="status">Carregando catálogo...</p>
  }
  @if (erro) {
    <p role="alert">{{ erro }}</p>
  }
  <button
    type="button"
    class="sst-btn-link"
    (click)="carregar()"
    [disabled]="carregando || salvando"
  >
    Atualizar catálogo
  </button>
  @if (cardSelecionado !== 'Treinamentos' || modoVisualizacao !== 'lista') {
    <p role="status">
      Dados carregados da API: matriz LNT por cargo, vínculos colaborador × treinamento, certificações,
      reciclagens derivadas da validade e a matriz cruzada por NR.
    </p>
  }

  <header class="matriz-header">
    <h2>Matriz de Treinamentos</h2>
    @switch (cardSelecionado) {
      @case ('Visão Geral') {
        <button class="sst-btn sst-btn--dark" (click)="exportarMatriz()">Exportar Matriz</button>
      }
      @case ('LNT / Cargos') {
        <button class="sst-btn sst-btn--dark" (click)="navegarParaCadastro()">
          Novo LNT / Cargo
        </button>
      }
      @case ('Treinamentos') {
        <button class="sst-btn sst-btn--dark" (click)="navegarParaCadastro()">
          Novo Treinamento
        </button>
      }
      @case ('Certificações') {
        <button class="sst-btn sst-btn--dark" (click)="abrirModalCertificacao()">
          Vincular Certificação
        </button>
      }
      @case ('Reciclagens') {
        <div class="matriz-header-actions">
          <button class="sst-btn sst-btn--dark" (click)="navegarParaCadastro()">
            Nova Reciclagem
          </button>
          <button class="sst-btn sst-btn--dark" (click)="abrirModalReciclagem()">
            Vincular Reciclagem
          </button>
        </div>
      }
    }
  </header>

  <section class="cards-grid">
    @for (card of resumos; track card.titulo) {
      <div
        class="card-summary"
        [class.card-summary--active]="cardSelecionado === card.titulo"
        (click)="selecionarCard(card.titulo)"
      >
        <span class="card-summary__title">{{ card.titulo }}</span>
        @if (card.total !== undefined) {
          <strong class="card-summary__val">{{ card.total }}</strong>
        } @else {
          <strong class="card-summary__val card-summary__val--icon">{{ card.icone }}</strong>
        }
      </div>
    }
  </section>

  <div class="tables-column">
    @if (cardSelecionado === 'Visão Geral') {
      <section class="table-card">
        <h3 class="table-card__title">Matriz Cruzada de Conformidade por Colaborador</h3>
        <div class="table-wrapper">
          <table>
            <thead>
              <tr>
                <th>Colaborador</th>
                <th>Cargo</th>
                <th class="text-center">NR-06 (EPI)</th>
                <th class="text-center">NR-11 (Empilhadeira)</th>
                <th class="text-center">NR-12 (Máquinas)</th>
                <th class="text-center">NR-17 (Ergonomia)</th>
                <th class="text-center">NR-35 (Altura)</th>
                <th scope="col" class="sst-text-right">Ações</th>
              </tr>
            </thead>
            <tbody>
              @for (row of matrizCruzada; track row.colaborador) {
                <tr>
                  <td>
                    <strong>{{ row.colaborador }}</strong>
                  </td>
                  <td>{{ row.cargo }}</td>
                  <td class="text-center">
                    <span
                      class="badge"
                      [ngClass]="
                        row.nr06 === 'N/A' ? 'badge--na' : 'badge--' + row.nr06.toLowerCase()
                      "
                      >{{ row.nr06 }}</span
                    >
                  </td>
                  <td class="text-center">
                    <span
                      class="badge"
                      [ngClass]="
                        row.nr11 === 'N/A' ? 'badge--na' : 'badge--' + row.nr11.toLowerCase()
                      "
                      >{{ row.nr11 }}</span
                    >
                  </td>
                  <td class="text-center">
                    <span
                      class="badge"
                      [ngClass]="
                        row.nr12 === 'N/A' ? 'badge--na' : 'badge--' + row.nr12.toLowerCase()
                      "
                      >{{ row.nr12 }}</span
                    >
                  </td>
                  <td class="text-center">
                    <span
                      class="badge"
                      [ngClass]="
                        row.nr17 === 'N/A' ? 'badge--na' : 'badge--' + row.nr17.toLowerCase()
                      "
                      >{{ row.nr17 }}</span
                    >
                  </td>
                  <td class="text-center">
                    <span
                      class="badge"
                      [ngClass]="
                        row.nr35 === 'N/A' ? 'badge--na' : 'badge--' + row.nr35.toLowerCase()
                      "
                      >{{ row.nr35 }}</span
                    >
                  </td>
                  <td class="sst-text-right">
                    <button type="button" class="sst-btn-link" (click)="abrirModalEdicaoGeral(row)">
                      Editar
                    </button>
                  </td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      </section>
    }

    @if (cardSelecionado === 'LNT / Cargos') {
      <section class="table-card">
        <header class="table-card__toolbar">
          <h3 class="table-card__title">LNT / Cargos Cadastrados</h3>
          <div class="table-toggle" role="group" aria-label="Modo de visualização">
            <button
              type="button"
              class="table-toggle__btn"
              [class.table-toggle__btn--active]="modoVisualizacao === 'colaborador'"
              (click)="setModoVisualizacao('colaborador')"
            >
              Por Colaborador
            </button>
            <button
              type="button"
              class="table-toggle__btn"
              [class.table-toggle__btn--active]="modoVisualizacao === 'lista'"
              (click)="setModoVisualizacao('lista')"
            >
              Lista Completa
            </button>
          </div>
        </header>

        <div class="table-wrapper">
          @if (modoVisualizacao === 'colaborador') {
            <table>
              <thead>
                <tr>
                  <th>Colaborador</th>
                  <th>Cargo</th>
                  <th>Setor</th>
                  <th>Treinamentos Pendentes</th>
                  <th>Status</th>
                  <th scope="col" class="sst-text-right">Ações</th>
                </tr>
              </thead>
              <tbody>
                @for (item of cargosLntColaborador; track item.colaborador) {
                  <tr>
                    <td>
                      <strong>{{ item.colaborador }}</strong>
                    </td>
                    <td>{{ item.cargo }}</td>
                    <td>{{ item.setor }}</td>
                    <td>{{ item.treinamentosPendentes }}</td>
                    <td>
                      <span
                        class="badge"
                        [ngClass]="item.status === 'Conforme' ? 'badge--ok' : 'badge--alerta'"
                      >
                        {{ item.status }}
                      </span>
                    </td>
                    <td class="sst-text-right">
                      <button
                        type="button"
                        class="sst-btn-link"
                        (click)="abrirModalEdicaoGeral(item)"
                      >
                        Editar
                      </button>
                    </td>
                  </tr>
                }
              </tbody>
            </table>
          } @else {
            <table>
              <thead>
                <tr>
                  <th>Cargo</th>
                  <th>Setor</th>
                  <th>Treinamentos Obrigatórios</th>
                  <th>Status</th>
                  <th scope="col" class="sst-text-right">Ações</th>
                </tr>
              </thead>
              <tbody>
                @for (cargo of cargosLnt; track cargo.cargo) {
                  <tr>
                    <td>
                      <strong>{{ cargo.cargo }}</strong>
                    </td>
                    <td>{{ cargo.setor }}</td>
                    <td>{{ cargo.treinamentosObrigatorios }}</td>
                    <td>
                      <strong>{{ cargo.status }}</strong>
                    </td>
                    <td class="sst-text-right">
                      <button
                        type="button"
                        class="sst-btn-link"
                        (click)="abrirModalEdicaoGeral(cargo)"
                      >
                        Editar
                      </button>
                    </td>
                  </tr>
                }
              </tbody>
            </table>
          }
        </div>
      </section>
    }

    @if (cardSelecionado === 'Treinamentos') {
      <section class="table-card">
        <header class="table-card__toolbar">
          <h3 class="table-card__title">Treinamentos Cadastrados</h3>
          <div class="table-toggle" role="group" aria-label="Modo de visualização">
            <button
              type="button"
              class="table-toggle__btn"
              [class.table-toggle__btn--active]="modoVisualizacao === 'colaborador'"
              (click)="setModoVisualizacao('colaborador')"
            >
              Por Colaborador
            </button>
            <button
              type="button"
              class="table-toggle__btn"
              [class.table-toggle__btn--active]="modoVisualizacao === 'lista'"
              (click)="setModoVisualizacao('lista')"
            >
              Lista Completa
            </button>
          </div>
        </header>

        <div class="table-wrapper">
          @if (modoVisualizacao === 'colaborador') {
            <table>
              <thead>
                <tr>
                  <th>Colaborador</th>
                  <th>Cargo</th>
                  <th>Treinamento</th>
                  <th>Conclusão</th>
                  <th>Status</th>
                  <th scope="col" class="sst-text-right">Ações</th>
                </tr>
              </thead>
              <tbody>
                @for (item of treinamentosColaborador; track item.colaborador + item.treinamento) {
                  <tr>
                    <td>
                      <strong>{{ item.colaborador }}</strong>
                    </td>
                    <td>{{ item.cargo }}</td>
                    <td>
                      <strong>{{ item.treinamento }}</strong>
                    </td>
                    <td>{{ item.dataConclusao }}</td>
                    <td>
                      <span
                        class="badge"
                        [ngClass]="item.status === 'Concluído' ? 'badge--ok' : 'badge--alerta'"
                      >
                        {{ item.status }}
                      </span>
                    </td>
                    <td class="sst-text-right">
                      <button
                        type="button"
                        class="sst-btn-link"
                        (click)="abrirModalEdicaoGeral(item)"
                      >
                        Editar
                      </button>
                    </td>
                  </tr>
                }
              </tbody>
            </table>
          } @else {
            <table>
              <thead>
                <tr>
                  <th>Código</th>
                  <th>Treinamento</th>
                  <th>Classificação</th>
                  <th>NR / Norma</th>
                  <th>Carga Horária</th>
                  <th>Validade Padrão</th>
                  <th>Status</th>
                  <th scope="col" class="sst-text-right">Ações</th>
                </tr>
              </thead>
              <tbody>
                @for (item of treinamentos; track item.id) {
                  <tr>
                    <td>
                      <strong>{{ item.codigo || '-' }}</strong>
                    </td>
                    <td>
                      <strong>{{ item.nome }}</strong>
                    </td>
                    <td>{{ item.classificacao }}</td>
                    <td>{{ item.nr }}</td>
                    <td>{{ item.cargaHoraria }}</td>
                    <td>{{ item.validadeMeses !== null ? item.validadeMeses + ' meses' : '-' }}</td>
                    <td>
                      <strong>{{ item.status }}</strong>
                    </td>
                    <td class="sst-text-right">
                      <button
                        type="button"
                        class="sst-btn-link"
                        (click)="abrirModalEdicaoGeral(item)"
                        [disabled]="salvando"
                      >
                        Editar
                      </button>
                      <button
                        type="button"
                        class="sst-btn-link"
                        (click)="excluir(item)"
                        [disabled]="salvando"
                      >
                        Excluir
                      </button>
                    </td>
                  </tr>
                }
              </tbody>
            </table>
          }
        </div>
      </section>
    }

    @if (cardSelecionado === 'Certificações') {
      <section class="table-card">
        <header class="table-card__toolbar">
          <h3 class="table-card__title">Certificações</h3>
          <div class="table-toggle" role="group" aria-label="Modo de visualização">
            <button
              type="button"
              class="table-toggle__btn"
              [class.table-toggle__btn--active]="modoVisualizacao === 'colaborador'"
              (click)="setModoVisualizacao('colaborador')"
            >
              Por Colaborador
            </button>
            <button
              type="button"
              class="table-toggle__btn"
              [class.table-toggle__btn--active]="modoVisualizacao === 'lista'"
              (click)="setModoVisualizacao('lista')"
            >
              Lista Completa
            </button>
          </div>
        </header>

        <div class="table-wrapper">
          @if (modoVisualizacao === 'colaborador') {
            <table>
              <thead>
                <tr>
                  <th>Colaborador</th>
                  <th>Cargo</th>
                  <th>Treinamento</th>
                  <th>Certificação</th>
                  <th>Validade</th>
                  <th>Status</th>
                  <th scope="col" class="sst-text-right">Ações</th>
                </tr>
              </thead>
              <tbody>
                @for (c of certificacoes; track c.colaborador + c.treinamento) {
                  <tr>
                    <td>
                      <strong>{{ c.colaborador }}</strong>
                    </td>
                    <td>{{ c.cargo }}</td>
                    <td>
                      <strong>{{ c.treinamento }}</strong>
                    </td>
                    <td>{{ c.certificacao }}</td>
                    <td>{{ c.validade }}</td>
                    <td>
                      <span class="badge" [ngClass]="'badge--' + (c.status?.toLowerCase() || 'ok')">
                        {{ c.status || 'Ativa' }}
                      </span>
                    </td>
                    <td class="sst-text-right">
                      <button type="button" class="sst-btn-link" (click)="abrirModalEdicaoGeral(c)">
                        Editar
                      </button>
                    </td>
                  </tr>
                }
              </tbody>
            </table>
          } @else {
            <table>
              <thead>
