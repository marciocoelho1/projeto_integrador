<file path="src/app/tela-dashboard/dashboard.html">
<header class="sst-header">
  <div>
    <h2 class="sst-header__main">Dashboard</h2>
    <p class="dashboard-atualizacao">
      {{ colaboradores().ativos }} de {{ colaboradores().total }} colaborador(es) ativo(s)
      @if (atualizadoEm()) {
        · atualizado em {{ atualizadoEm() }}
      }
    </p>
  </div>
  <div class="dashboard-acoes">
    <button
      type="button"
      class="sst-btn"
      data-acao="recarregar"
      (click)="recarregar()"
      [disabled]="carregando()"
    >
      Atualizar
    </button>
    <button type="button" class="sst-btn sst-btn--dark" data-acao="exportar" (click)="exportarRelatorio()">
      Exportar
    </button>
  </div>
</header>

@if (erro()) {
  <p class="dashboard-erro" role="alert">{{ erro() }}</p>
} @else if (carregando() && !atualizadoEm()) {
  <p class="dashboard-atualizacao">Carregando indicadores…</p>
}

<section class="dashboard-wrapper">

  <section class="sst-card alerts-card" aria-labelledby="titulo-alertas">
    <header class="alerts-card__header">
      <span class="alerts-card__icon" aria-hidden="true">⚠️</span>
      <h3 id="titulo-alertas" class="sst-card__title">Atenção Requerida</h3>
    </header>
    <ul class="alerts-list">
      @for (alerta of alertas(); track alerta.tipo + alerta.mensagem) {
        <li class="alert-item" [ngClass]="'alert-item--' + alerta.criticidade">
          <strong>{{ alerta.tipo }}:</strong> {{ alerta.mensagem }}
        </li>
      }
    </ul>
  </section>

  <div class="charts-grid">

    <article class="sst-card chart-card">
      <header>
        <h3 class="sst-card__title">Certificações de Colaboradores</h3>
        <p class="sst-card__subtitle">
          Status das certificações registradas ({{ certificacoes().total }} no total)
        </p>
      </header>

      <div class="chart-content-with-side">
        <figure class="chart-placeholder bar-chart">
          <div class="mock-bar-chart" role="img" aria-label="Gráfico de barras de certificações">
            <div class="bar-col">
              <div class="bar bar--active" [style.height.%]="alturaBarra(certificacoes().ativas)">
                <span class="bar-val">{{ certificacoes().ativas }}</span>
              </div>
              <span class="bar-lbl">Ativas</span>
            </div>
            <div class="bar-col">
              <div class="bar bar--expired" [style.height.%]="alturaBarra(certificacoes().vencidas)">
                <span class="bar-val">{{ certificacoes().vencidas }}</span>
              </div>
              <span class="bar-lbl">Vencidas</span>
            </div>
          </div>
        </figure>

        <aside class="side-info-panel">
          <span class="side-info-panel__title">Resumo</span>
          <div class="side-info-item">
            <span class="dot dot--active"></span>
            <div>
              <p class="side-info-label">Ativas</p>
              <strong class="side-info-val">{{ certificacoes().ativas }}</strong>
            </div>
          </div>
          <div class="side-info-item">
            <span class="dot dot--expired"></span>
            <div>
              <p class="side-info-label">Vencidas</p>
              <strong class="side-info-val text-alert">{{ certificacoes().vencidas }}</strong>
            </div>
          </div>
          <div class="side-info-item">
            <span class="dot dot--warning"></span>
            <div>
              <p class="side-info-label">Vencem em 30 dias</p>
              <strong class="side-info-val">{{ certificacoes().vencendoEm30Dias }}</strong>
            </div>
          </div>
        </aside>
      </div>
    </article>

    <article class="sst-card chart-card">
      <header>
        <h3 class="sst-card__title">Gestão de EPIs</h3>
        <p class="sst-card__subtitle">Unidades em estoque por situação do CA</p>
      </header>

      <figure class="chart-placeholder pie-chart">
        <div class="mock-pie" role="img" aria-label="Gráfico de pizza mostrando a distribuição de EPIs">
          <div class="mock-pie__center">
            <strong>{{ epis().emEstoque }}</strong>
            <span>Em estoque</span>
          </div>
        </div>
      </figure>

      <ul class="pie-legend">
        <li><span class="legend-dot bg-green"></span> CA válido: <strong>{{ episComCaValido() }}</strong></li>
        <li>
          <span class="legend-dot bg-amber"></span> CA a vencer em 30 dias:
          <strong>{{ epis().proximoVencimento }}</strong>
        </li>
        <li><span class="legend-dot bg-blue"></span> CA vencido: <strong>{{ epis().vencidos }}</strong></li>
        <li>
          <span class="legend-dot bg-blue"></span> Entregues nos últimos 30 dias:
          <strong>{{ epis().entreguesUltimos30Dias }}</strong>
        </li>
      </ul>
    </article>

  </div>

  <article class="sst-card progress-card">
    <header class="progress-card__header">
      <div>
        <h3 class="sst-card__title">Reciclagens a Fazer</h3>
        <p class="sst-card__subtitle">Progresso dos treinamentos registrados por colaborador</p>
      </div>
      <strong class="progress-card__value">{{ treinamentos().porcentagem }}%</strong>
    </header>

    <div class="progress-track">
      <div
        class="progress-fill"
        [style.width.%]="treinamentos().porcentagem"
        role="progressbar"
        [attr.aria-valuenow]="treinamentos().porcentagem"
        aria-valuemin="0"
        aria-valuemax="100">
      </div>
    </div>

    <footer class="progress-card__footer">
      <span>Concluídos: <strong>{{ treinamentos().concluidos }}</strong></span>
      <span>Pendentes: <strong>{{ treinamentos().pendentes }}</strong></span>
      <span>Vencidos: <strong>{{ treinamentos().vencidos }}</strong></span>
      <span>Total: <strong>{{ treinamentos().total }}</strong></span>
    </footer>
  </article>

</section>
