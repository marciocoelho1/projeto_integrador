                maxlength="150"
              />
            </div>

            <div class="sst-form-group">
              <label for="cpf">CPF</label>
              <input
                type="text"
                id="cpf"
                #cpfInput
                class="sst-search__input sst-input-full"
                autocomplete="off"
                [(ngModel)]="novoColaborador.cpf"
                name="cpf"
                required
                maxlength="14"
              />
            </div>

            <div class="sst-form-group">
              <label for="email">E-mail</label>
              <input
                type="email"
                id="email"
                class="sst-search__input sst-input-full"
                autocomplete="email"
                [(ngModel)]="novoColaborador.email"
                name="email"
                email
                required
                maxlength="180"
              />
            </div>

            <div class="sst-form-group">
              <label for="cargo">Cargo</label>
              <input
                id="cargo"
                name="cargo"
                class="sst-search__input sst-input-full"
                [(ngModel)]="novoColaborador.cargo"
                maxlength="120"
                required
              />
            </div>

            <div class="sst-form-group">
              <label for="setor">Setor</label>
              <input
                id="setor"
                name="setor"
                class="sst-search__input sst-input-full"
                [(ngModel)]="novoColaborador.setor"
                maxlength="120"
                required
              />
            </div>

            <div class="sst-form-group">
              <label for="matricula">Matrícula</label
              ><input
                id="matricula"
                name="matricula"
                class="sst-search__input sst-input-full"
                [(ngModel)]="novoColaborador.matricula"
                maxlength="30"
                required
              />
            </div>
            <div class="sst-form-group">
              <label for="status-colaborador">Status</label
              ><select
                id="status-colaborador"
                name="statusColaborador"
                class="sst-search__input sst-input-full"
                [(ngModel)]="novoColaborador.status"
                required
              >
                <option>Ativo</option>
                <option>Inativo</option>
                <option>Afastado</option>
              </select>
            </div>
            <footer class="sst-form-actions sst-col-span-2">
              <button type="submit" class="sst-btn sst-btn--dark" [disabled]="salvandoColaborador">
                Salvar Colaborador
              </button>
            </footer>
          </form>
        </section>
      }

      @case ('treinamento') {
        <section class="sst-card sst-card--form">
          <header class="sst-card__toolbar">
            <h2 class="sst-card__title">Cadastro de Matriz de Treinamento</h2>
          </header>

          <form
            class="sst-form-grid"
            #formularioTreinamento="ngForm"
            (ngSubmit)="salvarTreinamento(formularioTreinamento)"
          >
            <div class="sst-form-group sst-col-span-2">
              <label for="desc-treinamento">Descrição do Treinamento</label>
              <input
                type="text"
                id="desc-treinamento"
                name="desc-treinamento"
                [(ngModel)]="novoTreinamento.nome"
                class="sst-search__input sst-input-full"
                required
                maxlength="180"
              />
            </div>

            <div class="sst-form-group">
              <label for="classificacao">Classificação</label>
              <input
                type="text"
                id="classificacao"
                name="classificacao"
                [(ngModel)]="novoTreinamento.classificacao"
                list="lista-classificacao"
                class="sst-search__input sst-input-full"
                required
                maxlength="60"
              />
              <datalist id="lista-classificacao">
                <option value="Integração"></option>
                <option value="Específico"></option>
                <option value="Reciclagem"></option>
              </datalist>
            </div>

            <div class="sst-form-group">
              <label for="nr">NR Regulamentadora</label>
              <input
                type="text"
                id="nr"
                name="nr"
                [(ngModel)]="novoTreinamento.nr"
                list="lista-nr"
                class="sst-search__input sst-input-full"
                maxlength="60"
              />
              <datalist id="lista-nr">
                <option value="NR-06 (EPI)"></option>
                <option value="NR-11 (Movimentação de Materiais)"></option>
                <option value="NR-12 (Máquinas e Equipamentos)"></option>
                <option value="NR-17 (Ergonomia)"></option>
              </datalist>
            </div>

            <div class="sst-form-group">
              <label for="carga-horaria">Carga Horária</label>

              <input
                type="text"
                id="carga-horaria"
                name="carga-horaria"
                [(ngModel)]="novoTreinamento.cargaHoraria"
                class="sst-search__input sst-input-full"
                placeholder="...h...min"
                required
                maxlength="30"
              />
            </div>

            <div class="sst-form-group">
              <label for="status">Status Padrão</label>
              <input
                type="text"
                id="status"
                name="status"
                [(ngModel)]="novoTreinamento.status"
                list="lista-status"
                class="sst-search__input sst-input-full"
                required
                pattern="Ativo|Inativo"
              />
              <datalist id="lista-status">
                <option value="Ativo"></option>
                <option value="Inativo"></option>
              </datalist>
            </div>

            <div class="sst-form-group">
              <label for="codigo">Código</label
              ><input
                id="codigo"
                name="codigo"
                class="sst-search__input sst-input-full"
                [(ngModel)]="novoTreinamento.codigo"
                maxlength="30"
                required
              />
            </div>
            <div class="sst-form-group">
              <label for="validade-meses">Validade (meses, opcional)</label
              ><input
                id="validade-meses"
                name="validadeMeses"
                type="number"
                min="0"
                max="2147483647"
                step="1"
                class="sst-search__input sst-input-full"
                [(ngModel)]="novoTreinamento.validadeMeses"
              />
            </div>
            <footer class="sst-form-actions sst-col-span-2">
              <button type="submit" class="sst-btn sst-btn--dark" [disabled]="salvandoTreinamento">
                Salvar Treinamento
              </button>
            </footer>
          </form>
        </section>
      }

      @case ('epi') {
        <section class="sst-card sst-card--form">
          <header class="sst-card__toolbar">
            <h2 class="sst-card__title">Cadastro de Novo EPI</h2>
          </header>

          <form class="sst-form-grid" #formularioEpi="ngForm" (ngSubmit)="salvarEPI(formularioEpi)">
            <div class="sst-form-group sst-col-span-2">
              <label for="desc-epi">Descrição do EPI</label>
              <input
                type="text"
                id="desc-epi"
                name="desc-epi"
                [(ngModel)]="novoEpi.descricao"
                class="sst-search__input sst-input-full"
                required
                maxlength="180"
              />
            </div>

            <div class="sst-form-group">
              <label for="quantidade">Quantidade (Estoque)</label>

              <input
                type="number"
                step="1"
                min="0"
                max="2147483647"
                id="quantidade"
                name="quantidade"
                [(ngModel)]="novoEpi.quantidade"
                class="sst-search__input sst-input-full"
                required
              />
            </div>

            <div class="sst-form-group">
              <label for="ca">Número do CA (Certificado de Aprovação)</label>
              <input
                type="text"
                id="ca"
                name="ca"
                [(ngModel)]="novoEpi.ca"
                class="sst-search__input sst-input-full"
                required
                maxlength="30"
              />
            </div>

            <div class="sst-form-group">
              <label for="data-inclusao">Data de Inclusão</label>

              <input
                type="date"
                id="data-inclusao"
                name="data-inclusao"
                [(ngModel)]="novoEpi.inclusao"
                class="sst-search__input sst-input-full"
                required
              />
            </div>

            <div class="sst-form-group">
              <label for="data-validade">Data de Validade (CA)</label>
              <input
                type="date"
                id="data-validade"
                name="data-validade"
                [(ngModel)]="novoEpi.validade"
                class="sst-search__input sst-input-full"
                required
              />
            </div>

            <footer class="sst-form-actions sst-col-span-2">
              <button type="submit" class="sst-btn sst-btn--dark" [disabled]="salvandoEpi">
                Salvar EPI
              </button>
            </footer>
          </form>
        </section>
      }

      @case ('lnt') {
        <section class="sst-card sst-card--form">
          <header class="sst-card__toolbar">
            <h2 class="sst-card__title">Cadastro de LNT / Cargo</h2>
          </header>

          <form class="sst-form-grid" (submit)="$event.preventDefault(); salvarLnt()">
            <div class="sst-form-group">
              <label for="nome-cargo">Nome do Cargo</label>
              <input
                type="text"
                id="nome-cargo"
                class="sst-search__input sst-input-full"
                required
              />
            </div>

            <div class="sst-form-group">
              <label for="setor-cargo">Setor</label>
              <input
                type="text"
                id="setor-cargo"
                list="lista-setores-lnt"
                class="sst-search__input sst-input-full"
                required
              />
              <datalist id="lista-setores-lnt">
                <option value="Frente de Loja"></option>
                <option value="Estoque"></option>
                <option value="Açougue"></option>
                <option value="Administrativo"></option>
                <option value="Padaria"></option>
                <option value="Logística"></option>
              </datalist>
            </div>

            <footer class="sst-form-actions sst-col-span-2">
              <button type="submit" class="sst-btn sst-btn--dark">Salvar LNT / Cargo</button>
