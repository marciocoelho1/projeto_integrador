            <h2 class="sst-card__title">Cadastro de Reciclagem</h2>
          </header>

          <form class="sst-form-grid" (submit)="$event.preventDefault(); salvarReciclagem()">
            <div class="sst-form-group sst-col-span-2">
              <label for="nome-reciclagem">Nome da Reciclagem</label>
              <input
                type="text"
                id="nome-reciclagem"
                class="sst-search__input sst-input-full"
                required
              />
            </div>

            <div class="sst-form-group">
              <label for="nr-reciclagem">NR Referente</label>
              <input
                type="text"
                id="nr-reciclagem"
                list="lista-nr-reciclagem"
                class="sst-search__input sst-input-full"
                required
              />
              <datalist id="lista-nr-reciclagem">
                <option value="NR-06 (EPI)"></option>
                <option value="NR-11 (Movimentação de Materiais)"></option>
                <option value="NR-12 (Máquinas e Equipamentos)"></option>
                <option value="NR-17 (Ergonomia)"></option>
                <option value="NR-35 (Trabalho em Altura)"></option>
                <option value="NR-23 (Brigada de Incêndio)"></option>
              </datalist>
            </div>

            <div class="sst-form-group">
              <label for="carga-horaria-rec">Carga Horária</label>
              <input
                type="text"
                id="carga-horaria-rec"
                class="sst-search__input sst-input-full"
                placeholder="Ex: 8h"
                required
              />
            </div>

            <div class="sst-form-group sst-col-span-2">
              <label for="validade-rec">Validade (meses ou período)</label>
              <input
                type="text"
                id="validade-rec"
                class="sst-search__input sst-input-full"
                placeholder="Ex: 12 meses"
                required
              />
            </div>

            <footer class="sst-form-actions sst-col-span-2">
              <button type="submit" class="sst-btn sst-btn--dark">Salvar Reciclagem</button>
            </footer>
          </form>
        </section>
      }
    }
  </section>
</div>
