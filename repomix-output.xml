<file path="src/sql/migracoes/001-unicidade-colaborador-epi.sql">
-- Unicidade de CPF/e-mail do colaborador e de CA do EPI, e validação do período do EPI.
-- Aplicar SOMENTE em banco que já tem as tabelas criadas por criar-tabelas.sql.
-- Não recriar nem apagar tabela: aqui só entram constraints.
--
-- Os nomes usados aqui são explícitos e iguais aos de criar-tabelas.sql
-- (colaboradores_cpf_key, colaboradores_email_key, epis_ca_key, epis_periodo_check),
-- para que um banco novo e um banco migrado fiquem iguais.
-- atenção: CHECK com mais de uma coluna recebe o nome automático "<tabela>_check";
-- por isso o CHECK do período foi nomeado explicitamente nas duas pontas.
--
-- Limite conhecido: UNIQUE (email) compara maiúsculas/minúsculas. A aplicação grava sempre
-- em minúsculas (ColaboradorRequest), então a API não aceita variação de caixa; um INSERT
-- direto em SQL com e-mail em maiúscula passa pela constraint. O passo 2 abaixo padroniza
-- os registros antigos.
--
-- Ordem de execução: 1) conferências  2) padronização do e-mail  3) constraints  4) conferência final.

-- 1) Conferências. Cada SELECT precisa retornar ZERO linhas.
--    Se retornar linha, corrija os dados antes de criar a constraint:
--    a constraint falha e a aplicação fica com ddl-auto=validate sem subir.

-- 1.1 CPF repetido
SELECT cpf, COUNT(*) AS ocorrencias
FROM colaboradores
GROUP BY cpf
HAVING COUNT(*) > 1;

-- 1.2 E-mail repetido (comparação sem diferenciar maiúsculas/minúsculas)
SELECT lower(email) AS email, COUNT(*) AS ocorrencias
FROM colaboradores
GROUP BY lower(email)
HAVING COUNT(*) > 1;

-- 1.3 CA repetido
SELECT ca, COUNT(*) AS ocorrencias
FROM epis
GROUP BY ca
HAVING COUNT(*) > 1;

-- 1.4 EPI com validade anterior à inclusão
SELECT id, inclusao, validade
FROM epis
WHERE validade < inclusao;

-- 2) Padronizar o e-mail em minúsculas (a aplicação grava minúsculo; registros antigos
--    em maiúsculas escapariam da checagem de duplicidade). Rodar só depois de 1.2.
UPDATE colaboradores
SET email = lower(email)
WHERE email <> lower(email);

SELECT email, COUNT(*) AS ocorrencias
FROM colaboradores
GROUP BY email
HAVING COUNT(*) > 1;

-- 3) Constraints
ALTER TABLE colaboradores
  ADD CONSTRAINT colaboradores_cpf_key UNIQUE (cpf);

ALTER TABLE colaboradores
  ADD CONSTRAINT colaboradores_email_key UNIQUE (email);

ALTER TABLE epis
  ADD CONSTRAINT epis_ca_key UNIQUE (ca);

ALTER TABLE epis
  ADD CONSTRAINT epis_periodo_check CHECK (validade >= inclusao);

-- 4) Conferência final: deve listar as quatro constraints acima.
SELECT conrelid::regclass AS tabela, conname, contype
FROM pg_constraint
WHERE connamespace = 'public'::regnamespace
  AND conname IN (
    'colaboradores_cpf_key',
    'colaboradores_email_key',
    'epis_ca_key',
    'epis_periodo_check'
  )
ORDER BY conname;
</file>

<file path="src/test/java/br/com/senac/sgsst/api/AuthControllerTest.java">
package br.com.senac.sgsst.api;

import br.com.senac.sgsst.dto.LoginResponse;
import br.com.senac.sgsst.dto.UsuarioResponse;
import br.com.senac.sgsst.dto.UsuarioSessaoResponse;
import br.com.senac.sgsst.exception.ApiExceptionHandler;
import br.com.senac.sgsst.exception.CredencialInvalidaException;
import br.com.senac.sgsst.security.ContextoUsuario;
import br.com.senac.sgsst.security.UsuarioSessao;
import br.com.senac.sgsst.service.AuthService;
import br.com.senac.sgsst.service.UsuarioService;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.springframework.http.MediaType;
import org.springframework.test.web.servlet.MockMvc;
import org.springframework.test.web.servlet.setup.MockMvcBuilders;

import java.time.Instant;
import java.util.Set;

import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.*;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.*;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.*;

class AuthControllerTest {

  AuthService auth;
  UsuarioService usuarios;
  MockMvc mvc;

  @BeforeEach void setup() {
    auth = mock(AuthService.class);
    usuarios = mock(UsuarioService.class);
    mvc = MockMvcBuilders
      .standaloneSetup(new AuthController(auth, usuarios))
      .setControllerAdvice(new ApiExceptionHandler())
      .build();
  }

  @Test void loginDevolveTokenEUsuario() throws Exception {
    when(auth.entrar(any())).thenReturn(new LoginResponse(
      "token-123",
      Instant.parse("2026-11-16T20:00:00Z"),
      new UsuarioSessaoResponse(1, "ana", "Ana Souza", "Administrador TST", java.util.List.of("sgst_epis"))
    ));

    mvc.perform(post("/api/auth/login")
      .contentType(MediaType.APPLICATION_JSON)
      .content("{\"login\": \"ana\", \"senha\": \"senha123\"}"))
      .andExpect(status().isOk())
      .andExpect(jsonPath("$.token").value("token-123"))
      .andExpect(jsonPath("$.usuario.grupo").value("Administrador TST"))
      .andExpect(jsonPath("$.usuario.modulos[0]").value("sgst_epis"))
      .andExpect(jsonPath("$.usuario.senha").doesNotExist());
  }

  @Test void credencialInvalidaRetorna401() throws Exception {
    when(auth.entrar(any())).thenThrow(new CredencialInvalidaException("Usuário ou senha inválidos."));

    mvc.perform(post("/api/auth/login")
      .contentType(MediaType.APPLICATION_JSON)
      .content("{\"login\": \"ana\", \"senha\": \"errada\"}"))
      .andExpect(status().isUnauthorized())
      .andExpect(jsonPath("$.mensagem").value("Usuário ou senha inválidos."));
  }

  @Test void loginSemCamposRetorna400() throws Exception {
    mvc.perform(post("/api/auth/login")
      .contentType(MediaType.APPLICATION_JSON)
      .content("{}"))
      .andExpect(status().isBadRequest());
  }

  @Test void bootstrapCriaPrimeiroAdministrador() throws Exception {
    when(usuarios.criarPrimeiroAdministrador(any())).thenReturn(new UsuarioResponse(
      1, "Admin", "admin", "admin@example.test", "12345678901",
      1, "Administrador TST", "Ativo", java.util.List.of(), null
    ));

    mvc.perform(post("/api/auth/bootstrap")
      .contentType(MediaType.APPLICATION_JSON)
      .content("{\"nomeCompleto\": \"Admin\", \"login\": \"admin\", \"email\": \"admin@example.test\", \"cpf\": \"12345678901\", \"grupoId\": 1, \"status\": \"Ativo\", \"senha\": \"senha123\"}"))
      .andExpect(status().isCreated())
      .andExpect(header().string("Location", "/api/usuarios/1"))
      .andExpect(jsonPath("$.login").value("admin"));
  }

  @Test void sessaoSemContextoRetorna401EComContextoRetornaDados() throws Exception {
    mvc.perform(get("/api/auth/sessao"))
      .andExpect(status().isUnauthorized());

    var sessao = new UsuarioSessao(1, "ana", "Ana Souza", "Administrador TST", Set.of("sgst_epis"));
    ContextoUsuario.definir(sessao);

    try {
      mvc.perform(get("/api/auth/sessao"))
        .andExpect(status().isOk())
        .andExpect(jsonPath("$.login").value("ana"))
        .andExpect(jsonPath("$.grupo").value("Administrador TST"))
        .andExpect(jsonPath("$.modulos[0]").value("sgst_epis"));
    } finally {
      ContextoUsuario.limpar();
    }
  }

  @Test void logoutResponde204EEncerraATokenRecebida() throws Exception {
    mvc.perform(post("/api/auth/logout").header("Authorization", "Bearer token-123"))
      .andExpect(status().isNoContent());

    verify(auth).sair("Bearer token-123");
  }

  @Test void recuperarSenhaRespondeMensagemGenerica() throws Exception {
    when(auth.solicitarRedefinicao(any()))
      .thenReturn(new br.com.senac.sgsst.dto.MensagemResponse("Solicitação registrada."));

    mvc.perform(post("/api/auth/recuperar-senha")
      .contentType(MediaType.APPLICATION_JSON)
      .content("{\"login\": \"ana\"}"))
      .andExpect(status().isOk())
      .andExpect(jsonPath("$.mensagem").value("Solicitação registrada."));
  }

  @Test void redefinirSenhaComCodigoInvalidoRetorna400() throws Exception {
    doThrow(new br.com.senac.sgsst.exception.RequisicaoInvalidaException("Código de redefinição inválido."))
      .when(auth).redefinirSenha(any());

    mvc.perform(post("/api/auth/redefinir-senha")
      .contentType(MediaType.APPLICATION_JSON)
      .content("{\"token\": \"x\", \"senha\": \"novaSenha1\"}"))
      .andExpect(status().isBadRequest())
      .andExpect(jsonPath("$.mensagem").value("Código de redefinição inválido."));
  }
}
</file>

<file path="src/test/java/br/com/senac/sgsst/api/CargoControllerTest.java">
package br.com.senac.sgsst.api;
import br.com.senac.sgsst.dto.*;
import br.com.senac.sgsst.service.CargoService;
import br.com.senac.sgsst.exception.*;
import java.util.List;
import static org.mockito.Mockito.*;
class CargoControllerTest extends CrudControllerContractTest {
  CargoService service;
  Object controller() {
    service = mock(CargoService.class);
    var response = new CargoResponse(1, "Operador de Empilhadeira", "Estoque / Logística", "Ativo");
    when(service.listar()).thenReturn(List.of(response));
    when(service.buscarPorId(1)).thenReturn(response);
    when(service.criar(any())).thenReturn(response);
    when(service.atualizar(eq(1), any())).thenReturn(response);
    when(service.buscarPorId(404)).thenThrow(new RecursoNaoEncontradoException("Não encontrado."));
    when(service.atualizar(eq(404), any())).thenThrow(new RecursoNaoEncontradoException("Não encontrado."));
    doThrow(new RecursoNaoEncontradoException("Não encontrado.")).when(service).excluir(404);
    return new CargoController(service);
  }
  String endpoint() { return "/api/cargos"; }
  String payload() { return "{\"nome\": \"Operador de Empilhadeira\", \"setor\": \"Estoque / Logística\", \"status\": \"Ativo\"}"; }
  void conflict() { when(service.criar(any())).thenThrow(new org.springframework.dao.DataIntegrityViolationException("test")); }
  @org.junit.jupiter.api.Test void statusForaDaListaRetorna400() throws Exception {
    mvc.perform(org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post(endpoint())
      .contentType(org.springframework.http.MediaType.APPLICATION_JSON)
      .content(payload().replace("\"Ativo\"", "\"Afastado\"")))
      .andExpect(org.springframework.test.web.servlet.result.MockMvcResultMatchers.status().isBadRequest());
  }
  @org.junit.jupiter.api.Test void substituiMatrizDeTreinamentosDoCargo() throws Exception {
    when(service.substituirMatriz(eq(1), any())).thenReturn(new LntResponse(1, "Operador de Empilhadeira", "Estoque / Logística", "Ativo",
      List.of(new CargoTreinamentoResponse(1, 2, "NR-11 Operação Segura de Empilhadeira", "NR-11", true))));
    mvc.perform(org.springframework.test.web.servlet.request.MockMvcRequestBuilders.put(endpoint() + "/1/treinamentos")
      .contentType(org.springframework.http.MediaType.APPLICATION_JSON)
      .content("{\"treinamentos\": [{\"treinamentoId\": 2, \"obrigatorio\": true}]}"))
      .andExpect(org.springframework.test.web.servlet.result.MockMvcResultMatchers.status().isOk())
      .andExpect(org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath("$.treinamentos[0].treinamentoId").value(2))
      .andExpect(org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath("$.cargo").value("Operador de Empilhadeira"));
  }
  @org.junit.jupiter.api.Test void matrizSemListaRetorna400() throws Exception {
    mvc.perform(org.springframework.test.web.servlet.request.MockMvcRequestBuilders.put(endpoint() + "/1/treinamentos")
      .contentType(org.springframework.http.MediaType.APPLICATION_JSON)
      .content("{}"))
      .andExpect(org.springframework.test.web.servlet.result.MockMvcResultMatchers.status().isBadRequest());
  }
  @org.junit.jupiter.api.Test void matrizComTreinamentoNuloRetorna400() throws Exception {
    mvc.perform(org.springframework.test.web.servlet.request.MockMvcRequestBuilders.put(endpoint() + "/1/treinamentos")
      .contentType(org.springframework.http.MediaType.APPLICATION_JSON)
      .content("{\"treinamentos\": [{\"obrigatorio\": true}]}"))
      .andExpect(org.springframework.test.web.servlet.result.MockMvcResultMatchers.status().isBadRequest());
  }
  @org.junit.jupiter.api.Test void matrizComTreinamentoInexistenteRetorna400() throws Exception {
    when(service.substituirMatriz(eq(1), any())).thenThrow(new RequisicaoInvalidaException("Treinamento informado não existe: 99"));
    mvc.perform(org.springframework.test.web.servlet.request.MockMvcRequestBuilders.put(endpoint() + "/1/treinamentos")
      .contentType(org.springframework.http.MediaType.APPLICATION_JSON)
      .content("{\"treinamentos\": [{\"treinamentoId\": 99, \"obrigatorio\": true}]}"))
