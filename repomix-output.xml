<file path="src/app/tela-configuracoes/configuracoes.html">
<div class="sst-layout">
  <header class="sst-header">
    <hgroup class="sst-header__titles">
      <p class="sst-header__breadcrumb">SGSST / Administração</p>
      <h1 class="sst-header__main">Configurações do Sistema</h1>
    </hgroup>
    
    <button type="button" class="sst-btn sst-btn--dark" (click)="actionNovoUsuario()">
      Cadastrar Novo Usuário
    </button>
  </header>

  <nav class="sst-nav" role="tablist" aria-label="Guias de Configuração">
    @for (guia of guiasNavegacao; track guia.id) {
      <button
        type="button"
        role="tab"
        class="sst-nav__item"
        [class.sst-nav__item--active]="guiaAtual() === guia.id"
        [attr.aria-selected]="guiaAtual() === guia.id"
        (click)="navegarGuia(guia.id)"
      >
        {{ guia.titulo }}
      </button>
    }
  </nav>

  <section class="sst-content">
    @switch (guiaAtual()) {
      
      
      @case ('usuarios') {
        <section class="sst-card" aria-labelledby="titulo-usuarios">
          <header class="sst-card__toolbar">
            <h2 id="titulo-usuarios" class="sst-card__title">Gestão de Usuários</h2>
            <search class="sst-search">
              <input 
                type="text" 
                class="sst-search__input" 
                style="width: 380px;" 
                placeholder="Buscar por nome, CPF/matrícula, grupo ou status..."
                [value]="termoBusca()" 
                (input)="termoBusca.set($any($event.target).value)" 
                aria-label="Buscar usuário" 
              />
            </search>
          </header>

          <table class="sst-table">
            <thead>
              <tr>
                <th scope="col">Usuário</th>
                <th scope="col">CPF / Matrícula</th>
                <th scope="col">Grupo de Acesso</th>
                <th scope="col">Status</th>
                <th scope="col" class="sst-text-right">Ações</th>
              </tr>
            </thead>
            <tbody>
              @for (usuario of usuariosFiltrados(); track usuario.id) {
                <tr>
                  <td>
                    <strong>{{ usuario.nomeCompleto }}</strong>
                    <span class="sst-table__subtext">{{ usuario.emailCorporativo }}</span>
                  </td>
                  <td>{{ usuario.cpf }}</td>
                  <td><span class="sst-badge sst-badge--grupo">{{ getNomeGrupo(usuario.grupoId) }}</span></td>
                  <td><span class="sst-badge" [class.sst-badge--ativo]="usuario.status === 'ativo'">{{ usuario.status | titlecase }}</span></td>
                  <td class="sst-text-right"><button class="sst-btn-link" (click)="actionEditarUsuario(usuario)">Editar</button></td>
                </tr>
              } @empty {
                <tr>
                  <td colspan="5" class="sst-text-center" style="padding: 2.5rem 1rem; color: var(--cor-texto-secundario); font-style: italic;">
                    Nenhum usuário encontrado com o termo "{{ termoBusca() }}".
                  </td>
                </tr>
              }
            </tbody>
          </table>
        </section>
      }

      
      @case ('grupos') {
        <div class="sst-grid">
          @for (grupo of gruposSst(); track grupo.id) {
            <article class="sst-card-group">
              <header class="sst-card-group__header">
                <h3>{{ grupo.nomenclatura }}</h3>
                <span class="sst-card-group__count">{{ grupo.modulosLiberados.length }} módulos</span>
              </header>
              <p class="sst-card-group__desc">{{ grupo.finalidade }}</p>
              <button class="sst-btn sst-btn--outline" (click)="irParaMatrizDoGrupo(grupo.id)">Ajustar Matriz</button>
            </article>
          }
        </div>
      }

      
      @case ('matriz') {
        <section class="sst-card" aria-labelledby="titulo-matriz">
          <header class="sst-card__toolbar">
            <h2 id="titulo-matriz" class="sst-card__title">Matriz de Permissões</h2>
            <select class="sst-select" [value]="grupoSelecionadoId()" (change)="grupoSelecionadoId.set($any($event.target).value)" aria-label="Selecione o grupo para editar a matriz">
              @for (grupo of gruposSst(); track grupo.id) {
                <option [value]="grupo.id">{{ grupo.nomenclatura }}</option>
              }
            </select>
          </header>

          <p class="sst-matrix-info" role="status">Você está editando as regras para: <strong>{{ grupoEmEdicao().nomenclatura }}</strong></p>

          <table class="sst-table sst-table--matrix">
            <thead>
              <tr>
                <th scope="col">Módulo do Sistema</th>
                <th scope="col">Descrição do Nível de Acesso</th>
                <th scope="col" class="sst-text-center">Permissão</th>
              </tr>
            </thead>
            <tbody>
              @for (mod of modulosDisponiveis; track mod.chave) {
                <tr>
                  <td><strong>{{ mod.titulo }}</strong></td>
                  <td>{{ mod.detalhe }}</td>
                  <td class="sst-text-center">
                    <label class="sst-switch" [attr.for]="'mod-' + mod.chave">
                      <input type="checkbox" 
                             [id]="'mod-' + mod.chave"
                             [checked]="grupoEmEdicao().modulosLiberados.includes(mod.chave)"
                             (change)="alternarAcessoModulo(mod.chave)" 
                             [attr.aria-label]="'Permitir acesso ao módulo ' + mod.titulo">
                      <span class="sst-switch__slider"></span>
                    </label>
                  </td>
                </tr>
              }
            </tbody>
          </table>
        </section>
      }

      
      @case ('globais') {
        <section class="sst-card sst-card--form" aria-labelledby="titulo-regras">
          <header>
            <h2 id="titulo-regras" class="sst-card__title">Regras de Negócio e Alertas</h2>
            <p class="sst-card__subtitle">Configure o comportamento autônomo do sistema SST.</p>
            @if (erroGlobais()) {
              <p class="sst-card__subtitle" role="alert">{{ erroGlobais() }}</p>
            } @else if (carregandoGlobais()) {
              <p class="sst-card__subtitle">Carregando configurações…</p>
            }
          </header>

          <form class="sst-form" (submit)="$event.preventDefault(); gravarAlteracoesGlobais()">
            <fieldset class="sst-form__list" style="border: none; padding: 0; margin: 0;">
              <legend class="visually-hidden">Configurações de Alertas do Sistema</legend>
              @for (regra of regrasAlertas(); track regra.codigo) {
                <div class="sst-form__row">
                  <div class="sst-form__text">
                    <label [attr.for]="'regra-' + regra.codigo">
                      <strong>{{ regra.nomeRegra }}</strong>
                      <span>{{ regra.descricaoRegra }}</span>
                    </label>
                  </div>
                  
                  <label class="sst-switch" [attr.for]="'regra-' + regra.codigo">
                    <input type="checkbox" 
                           [id]="'regra-' + regra.codigo"
                           [checked]="regra.isAtiva" 
                           (change)="alternarRegra(regra.codigo)" 
                           [attr.aria-label]="'Ativar regra ' + regra.nomeRegra">
                    <span class="sst-switch__slider"></span>
                  </label>
                </div>
              }
            </fieldset>

            <fieldset class="sst-form__list" style="border: none; padding: 0; margin: 0;">
              <legend class="visually-hidden">Parâmetros Globais do Sistema</legend>
              @for (parametro of parametrosEmEdicao(); track parametro.chave) {
                <div class="sst-form__row">
                  <div class="sst-form__text">
                    <label [attr.for]="'parametro-' + parametro.chave">
                      <strong>{{ parametro.chave }}</strong>
                      <span>{{ parametro.descricao }}</span>
                    </label>
                  </div>

                  <input
                    type="number"
                    min="0"
                    class="sst-search__input"
                    [id]="'parametro-' + parametro.chave"
                    [value]="parametro.valor"
                    (input)="alterarParametro(parametro.chave, $any($event.target).value)"
                  />
                </div>
              }
            </fieldset>

            <footer class="sst-form__actions">
              <button type="submit" class="sst-btn sst-btn--dark sst-btn--large">Salvar Configurações</button>
            </footer>
          </form>
        </section>
      }

      
      @case ('logs') {
        <section class="sst-card" aria-labelledby="titulo-logs">
          <header class="sst-card__toolbar" style="flex-wrap: wrap; gap: 1rem;">
            <h2 id="titulo-logs" class="sst-card__title">Histórico de Auditoria</h2>
            
            <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
              <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                <label for="data-inicio" style="font-size: 0.75rem; font-weight: 600;">Data Início</label>
                <input type="date" id="data-inicio" class="sst-search__input" 
                       [value]="filtroLogDataInicio()" 
                       (input)="filtroLogDataInicio.set($any($event.target).value)" />
              </div>

              <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                <label for="data-fim" style="font-size: 0.75rem; font-weight: 600;">Data Fim</label>
                <input type="date" id="data-fim" class="sst-search__input" 
                       [value]="filtroLogDataFim()" 
                       (input)="filtroLogDataFim.set($any($event.target).value)" />
              </div>

              <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                <label style="font-size: 0.75rem; font-weight: 600;">Pesquisar</label>
                <search class="sst-search">
                  <input type="text" class="sst-search__input" style="width: 260px;" 
                         placeholder="Usuário, módulo ou ação..."
                         [value]="filtroLogTermo()" 
                         (input)="filtroLogTermo.set($any($event.target).value)" />
                </search>
              </div>
            </div>
          </header>

          <div class="sst-table-wrapper">
            <table class="sst-table">
              <thead>
                <tr>
                  <th scope="col">Data / Hora</th>
                  <th scope="col">Usuário / Matrícula</th>
                  <th scope="col">Módulo</th>
                  <th scope="col">Ação</th>
                  <th scope="col">Detalhes</th>
                </tr>
              </thead>
              <tbody>
                @for (log of logsFiltrados(); track log.id) {
                  <tr>
                    <td style="white-space: nowrap;"><strong>{{ log.dataHora | date:'dd/MM/yyyy HH:mm' }}</strong></td>
                    <td>{{ log.usuario }}</td>
                    <td>{{ log.modulo }}</td>
                    <td>
                      <span class="sst-badge" 
                            [class.sst-badge--ativo]="log.acao === 'CRIACAO'"
                            [class.sst-badge--grupo]="log.acao === 'ACESSO'"
                            [style.background]="log.acao === 'EXCLUSAO' ? '#fef2f2' : ''"
                            [style.color]="log.acao === 'EXCLUSAO' ? '#991b1b' : ''">
                        {{ log.acao }}
                      </span>
                    </td>
                    <td>{{ log.descricao }}</td>
                  </tr>
                } @empty {
                  <tr>
                    <td colspan="5" class="sst-text-center" style="padding: 2.5rem 1rem; color: var(--cor-texto-secundario); font-style: italic;">
                      Nenhum registro de log encontrado com os filtros atuais.
                    </td>
                  </tr>
                }
              </tbody>
            </table>
          </div>
        </section>
      }

    }
  </section>

  @if (mostrarModalEdicaoUsuario()) {
    @if (usuarioEmEdicao(); as usuario) {
      <div class="sst-modal-overlay">
        <div class="sst-modal sst-card" style="max-width: 600px;">
          <header class="sst-card__toolbar">
            <h3 class="sst-card__title">{{ modoNovoUsuario() ? 'Novo Usuário' : 'Editar Usuário' }}</h3>
            <button type="button" class="sst-btn-link" (click)="fecharModalEdicaoUsuario()" style="font-size: 1.5rem; text-decoration: none;">&times;</button>
          </header>

          <form class="sst-form-grid" (submit)="$event.preventDefault(); salvarEdicaoUsuario()">
            <div class="sst-form-group sst-col-span-2">
              <label for="usr-edit-nome">Nome Completo</label>
              <input type="text" id="usr-edit-nome" class="sst-search__input sst-input-full" [(ngModel)]="usuario.nomeCompleto" name="nomeCompleto" required>
            </div>

            <div class="sst-form-group sst-col-span-2">
              <label for="usr-edit-email">E-mail Corporativo</label>
              <input type="email" id="usr-edit-email" class="sst-search__input sst-input-full" [(ngModel)]="usuario.emailCorporativo" name="emailCorporativo" required>
            </div>

            <div class="sst-form-group">
              <label for="usr-edit-login">Usuário de Acesso</label>
              <input type="text" id="usr-edit-login" class="sst-search__input sst-input-full" [(ngModel)]="usuario.login" name="login" required>
            </div>

            <div class="sst-form-group">
              <label for="usr-edit-senha">
                {{ modoNovoUsuario() ? 'Senha' : 'Nova Senha (opcional)' }}
              </label>
              <input type="password" id="usr-edit-senha" class="sst-search__input sst-input-full" [(ngModel)]="usuario.senha" name="senha" [required]="modoNovoUsuario()" minlength="6" maxlength="72">
            </div>

            <div class="sst-form-group">
              <label for="usr-edit-cpf">CPF / Matrícula</label>
              <input type="text" id="usr-edit-cpf" class="sst-search__input sst-input-full" [(ngModel)]="usuario.cpf" name="cpf" required>
            </div>

            <div class="sst-form-group">
              <label for="usr-edit-status">Status</label>
              <select id="usr-edit-status" class="sst-search__input sst-input-full" [(ngModel)]="usuario.status" name="status" required>
                <option value="ativo">Ativo</option>
                <option value="inativo">Inativo</option>
              </select>
            </div>

            <div class="sst-form-group sst-col-span-2">
              <label for="usr-edit-grupo">Grupo de Acesso</label>
              <select id="usr-edit-grupo" class="sst-search__input sst-input-full" [(ngModel)]="usuario.grupoId" name="grupoId" required>
                @for (grupo of gruposSst(); track grupo.id) {
                  <option [value]="grupo.id">{{ grupo.nomenclatura }}</option>
                }
              </select>
            </div>

            <footer class="sst-form-actions sst-col-span-2">
              <button type="button" class="sst-btn sst-btn--outline" (click)="fecharModalEdicaoUsuario()">Cancelar</button>
              <button type="submit" class="sst-btn sst-btn--dark" [disabled]="salvandoUsuario()">
                {{ salvandoUsuario() ? 'Salvando...' : (modoNovoUsuario() ? 'Cadastrar Usuário' : 'Salvar Alterações') }}
              </button>
            </footer>
          </form>
        </div>
      </div>
    }
  }
</div>
</file>

<file path="src/app/tela-configuracoes/configuracoes.ts">
import { ChangeDetectionStrategy, Component, OnInit, computed, effect, inject, signal } from '@angular/core';
import { CommonModule, TitleCasePipe } from '@angular/common';
import { FormsModule } from '@angular/forms';
import { Router } from '@angular/router';
import { AuditService } from '../service/audit.service';
import { type ChaveModulo } from '../service/dados-referencia.service';
import { AcessoService, type UsuarioApi } from '../service/acesso.service';
import { ToastService } from '../service/toast.service';
import { AuthService } from '../auth.service';
import { mensagemErroApi } from '../service/api-error';
import {
  ConfiguracoesGlobaisService,
  type ParametroSistema,
} from '../service/configuracoes-globais.service';

const ROTAS_SISTEMA = {
  novoUsuario: '/cadastramentos/novo-usuario',
  detalhesUsuario: (id: string) => `/cadastramentos/usuario/${id}`,
  editarUsuario: (id: string) => `/cadastramentos/editar-usuario/${id}`,
  resetarSenha: (id: string) => `/cadastramentos/usuario/${id}/senha`,
  matrizAcesso: (id: string) => `/cadastramentos/usuario/${id}/acessos`,
} as const;

type StatusUsuario = 'ativo' | 'inativo';

interface UsuarioSst {
  id: string;
  login: string;
  nomeCompleto: string;
  emailCorporativo: string;
  cpf: string;
  grupoId: string;
  status: StatusUsuario;
  senha?: string;
}

interface GrupoSst {
  id: string;
  nomenclatura: string;
  finalidade: string;
  modulosLiberados: ChaveModulo[];
}

interface ModuloSistema {
  chave: ChaveModulo;
  titulo: string;
  detalhe: string;
}

type GuiaConfiguracao = 'usuarios' | 'grupos' | 'matriz' | 'globais' | 'logs';

@Component({
  selector: 'app-configuracoes',
  standalone: true,
  imports: [CommonModule, FormsModule, TitleCasePipe],
  templateUrl: './configuracoes.html',
  styleUrl: './configuracoes.scss',
  changeDetection: ChangeDetectionStrategy.OnPush,
})
export class Configuracoes implements OnInit {
  private readonly router = inject(Router);
  private readonly toastService = inject(ToastService);
  private readonly auditService = inject(AuditService);
  private readonly acesso = inject(AcessoService);
  private readonly auth = inject(AuthService);
  private readonly globais = inject(ConfiguracoesGlobaisService);

  protected readonly rotas = ROTAS_SISTEMA;

  protected mostrarModalEdicaoUsuario = signal<boolean>(false);
  protected usuarioEmEdicao = signal<UsuarioSst | null>(null);
  protected modoNovoUsuario = signal<boolean>(false);
  protected salvandoUsuario = signal<boolean>(false);
  protected carregandoAcessos = signal<boolean>(false);

  protected readonly guiasNavegacao: { id: GuiaConfiguracao; titulo: string }[] = [
    { id: 'usuarios', titulo: 'Usuários do Sistema' },
    { id: 'grupos', titulo: 'Grupos de Usuários' },
    { id: 'matriz', titulo: 'Matriz de Acessos' },
    { id: 'globais', titulo: 'Configurações Globais' },
    { id: 'logs', titulo: 'Logs de Auditoria' },
  ];

  protected readonly guiaAtual = signal<GuiaConfiguracao>('usuarios');

  /** Carregado de GET /api/modulos. */
  protected modulosDisponiveis: ModuloSistema[] = [];

  /** Carregado de GET /api/grupos. */
  protected readonly gruposSst = signal<GrupoSst[]>([]);

  protected filtroLogTermo = signal('');
  protected filtroLogDataInicio = signal('');
  protected filtroLogDataFim = signal('');

  /** Os logs vêm de GET /api/auditoria (o servidor já aplica termo e intervalo de datas). */
  protected readonly logsFiltrados = computed(() => this.auditService.logs());

  /** Carregado de GET /api/usuarios. */
  protected readonly usuariosCadastrados = signal<UsuarioSst[]>([]);

  protected readonly termoBusca = signal('');

  protected readonly usuariosFiltrados = computed(() => {
    const termo = this.termoBusca().trim().toLowerCase();
    if (!termo) return this.usuariosCadastrados();

    return this.usuariosCadastrados().filter((usuario) => {
      const nome = usuario.nomeCompleto.toLowerCase();
      const cpfMatricula = usuario.cpf.toLowerCase();
      const status = usuario.status.toLowerCase();
      const grupoNome = this.getNomeGrupo(usuario.grupoId).toLowerCase();

      return (
        nome.includes(termo) ||
        cpfMatricula.includes(termo) ||
        status.includes(termo) ||
        grupoNome.includes(termo)
      );
    });
  });

  protected readonly grupoSelecionadoId = signal<string>('');

  protected readonly grupoEmEdicao = computed(
    () => this.gruposSst().find((g) => g.id === this.grupoSelecionadoId()) ?? this.gruposSst()[0],
  );

  /** Regras de alerta persistidas (GET /api/regras-alerta). */
  protected readonly regrasAlertas = this.globais.regras;

  /** Parâmetros globais de GET /api/parametros, em cópia editável enquanto a tela está aberta. */
  protected readonly parametrosEmEdicao = signal<ParametroSistema[]>([]);

  protected readonly erroGlobais = this.globais.erro;
  protected readonly carregandoGlobais = this.globais.carregando;
  protected readonly salvandoGlobais = this.globais.salvando;

  constructor() {
    // Carrega os logs da API ao abrir a guia e recarrega quando um filtro muda.
    effect(() => {
      if (this.guiaAtual() !== 'logs') {
        return;
      }

      this.auditService.carregar({
        termo: this.filtroLogTermo(),
        inicio: this.filtroLogDataInicio(),
        fim: this.filtroLogDataFim(),
      });
    });

    // A cópia editável dos parâmetros acompanha o que veio da API (na carga e a cada gravação).
    effect(() => {
      const parametros = this.globais.parametros();

      if (parametros.length > 0) {
        this.parametrosEmEdicao.set(parametros.map((parametro) => ({ ...parametro })));
      }
    });
  }

  ngOnInit(): void {
    this.carregarModulos();
    this.carregarGrupos();
    this.carregarUsuarios();
    this.globais.carregar();
  }

  protected navegarGuia(guia: GuiaConfiguracao): void {
    this.guiaAtual.set(guia);
  }

  protected getNomeGrupo(grupoId: string): string {
    return this.gruposSst().find((g) => g.id === grupoId)?.nomenclatura || 'Indefinido';
  }

  protected irParaMatrizDoGrupo(grupoId: string): void {
    this.grupoSelecionadoId.set(grupoId);
    this.guiaAtual.set('matriz');
  }

  /** Recalcula a matriz do grupo na API (PUT /api/grupos/{id}/modulos). */
  protected alternarAcessoModulo(chave: ChaveModulo): void {
    const grupo = this.grupoEmEdicao();

    if (!grupo) {
      return;
    }

    const modulos = grupo.modulosLiberados.includes(chave)
      ? grupo.modulosLiberados.filter((c) => c !== chave)
      : [...grupo.modulosLiberados, chave];

    this.gruposSst.update((lista) =>
      lista.map((g) => (g.id === grupo.id ? { ...g, modulosLiberados: modulos } : g)),
    );

    this.acesso.definirModulos(Number(grupo.id), modulos).subscribe({
      next: (resposta) =>
        this.gruposSst.update((lista) =>
          lista.map((g) =>
            g.id === grupo.id
              ? { ...g, modulosLiberados: resposta.modulos as ChaveModulo[] }
              : g,
          ),
        ),
      error: (erro) => {
        this.toastService.error(mensagemErroApi(erro));
        this.carregarGrupos();
      },
    });
  }

  /** Liga/desliga a regra na tela e grava em PUT /api/regras-alerta/{codigo}. */
  protected alternarRegra(codigo: string): void {
    const regra = this.regrasAlertas().find((atual) => atual.codigo === codigo);

    if (!regra) {
      return;
    }

    const isAtiva = !regra.isAtiva;

    this.regrasAlertas.update((lista) =>
      lista.map((atual) => (atual.codigo === codigo ? { ...atual, isAtiva } : atual)),
    );

    this.globais.definirAtiva(codigo, isAtiva).subscribe({
      error: (erro) => {
        this.toastService.error(mensagemErroApi(erro));
        this.globais.carregar();
      },
    });
  }

  protected alterarParametro(chave: string, valor: string): void {
    this.parametrosEmEdicao.update((lista) =>
      lista.map((parametro) => (parametro.chave === chave ? { ...parametro, valor } : parametro)),
    );
  }

  /**
   * Grava em PUT /api/parametros/{chave} só o que mudou em relação ao valor que veio do servidor,
   * para o botão "Salvar Configurações" não regravar tudo a cada clique.
   */
  protected gravarAlteracoesGlobais(): void {
    const originais = this.globais.parametros();
    const alterados = this.parametrosEmEdicao().filter(
      (parametro) =>
        parametro.valor !==
        (originais.find((original) => original.chave === parametro.chave)?.valor ?? ''),
    );

    if (alterados.length === 0) {
      this.toastService.warning('Nenhuma alteração de parâmetro para salvar.');
      return;
    }

    this.globais.salvarValores(alterados).subscribe({
      next: () => this.toastService.success('Parâmetros atualizados.'),
      error: (erro) => this.toastService.error(mensagemErroApi(erro)),
    });
  }

  actionNovoUsuario(): void {
    this.modoNovoUsuario.set(true);
    this.usuarioEmEdicao.set({
      id: '',
      login: '',
      nomeCompleto: '',
      emailCorporativo: '',
      cpf: '',
      grupoId: this.gruposSst()[0]?.id ?? '',
      status: 'ativo',
      senha: '',
    });
    this.mostrarModalEdicaoUsuario.set(true);
  }

  protected actionEditarUsuario(usuario: UsuarioSst): void {
    this.modoNovoUsuario.set(false);
    this.usuarioEmEdicao.set({ ...usuario, senha: '' });
    this.mostrarModalEdicaoUsuario.set(true);
  }

  protected fecharModalEdicaoUsuario(): void {
    this.mostrarModalEdicaoUsuario.set(false);
    this.modoNovoUsuario.set(false);
    this.usuarioEmEdicao.set(null);
  }

  protected salvarEdicaoUsuario(): void {
    const usuario = this.usuarioEmEdicao();

    if (!usuario || this.salvandoUsuario()) {
      return;
    }

    const novo = this.modoNovoUsuario();
    const senha = (usuario.senha ?? '').trim();

    if (!usuario.nomeCompleto.trim() || !usuario.login.trim()) {
      this.toastService.error('Informe o nome completo e o usuário de acesso.');
      return;
    }

    if (usuario.cpf.replace(/\D/g, '').length !== 11) {
      this.toastService.error('O CPF deve conter 11 dígitos.');
      return;
    }

    if (novo && (senha.length < 6 || senha.length > 72)) {
      this.toastService.error('Informe uma senha de 6 a 72 caracteres.');
      return;
    }

    if (!novo && senha && (senha.length < 6 || senha.length > 72)) {
      this.toastService.error('A nova senha deve ter de 6 a 72 caracteres.');
      return;
    }

    if (!usuario.grupoId) {
      this.toastService.error('Selecione o grupo de acesso.');
      return;
    }

    const dados = {
      nomeCompleto: usuario.nomeCompleto.trim(),
      login: usuario.login.trim(),
      email: usuario.emailCorporativo.trim(),
      cpf: usuario.cpf,
      grupoId: Number(usuario.grupoId),
      status: (usuario.status === 'ativo' ? 'Ativo' : 'Inativo') as 'Ativo' | 'Inativo',
      ...(senha ? { senha } : {}),
    };

    this.salvandoUsuario.set(true);

    const requisicao = novo
      ? this.acesso.criarUsuario(dados)
      : this.acesso.atualizarUsuario(Number(usuario.id), dados);

    requisicao.subscribe({
      next: (salvo) => {
        this.salvandoUsuario.set(false);
        this.usuariosCadastrados.update((lista) =>
          novo
            ? [...lista, this.paraUsuarioSst(salvo)]
            : lista.map((u) =>
                u.id === String(salvo.id) ? this.paraUsuarioSst(salvo) : u,
              ),
        );
        this.toastService.success(
          novo
            ? `Usuário "${salvo.nomeCompleto}" cadastrado com sucesso!`
            : `Usuário "${salvo.nomeCompleto}" atualizado com sucesso!`,
        );
        this.auditService.registrarAcao(
          this.auth.getCurrentUser()?.nomeExibicao ?? 'Administrador',
          'Configurações',
          novo ? 'CRIACAO' : 'EDICAO',
          `${novo ? 'Cadastrou' : 'Atualizou'} usuário ${salvo.nomeCompleto}`,
        );
        this.fecharModalEdicaoUsuario();
      },
      error: (erro) => {
        this.salvandoUsuario.set(false);
        this.toastService.error(mensagemErroApi(erro));
      },
    });
  }

  private carregarModulos(): void {
    this.acesso.listarModulos().subscribe({
      next: (modulos) =>
        (this.modulosDisponiveis = modulos.map((modulo) => ({
          chave: modulo.chave as ChaveModulo,
          titulo: modulo.titulo,
          detalhe: modulo.detalhe,
        }))),
      error: (erro) => this.toastService.error(mensagemErroApi(erro)),
    });
  }

  private carregarGrupos(): void {
    this.acesso.listarGrupos().subscribe({
      next: (grupos) => {
        const mapeados: GrupoSst[] = grupos.map((grupo) => ({
          id: String(grupo.id),
          nomenclatura: grupo.nomenclatura,
          finalidade: grupo.finalidade,
          modulosLiberados: grupo.modulos as ChaveModulo[],
        }));

        this.gruposSst.set(mapeados);

        if (!this.grupoSelecionadoId() && mapeados.length > 0) {
          this.grupoSelecionadoId.set(mapeados[0].id);
        }
      },
      error: (erro) => this.toastService.error(mensagemErroApi(erro)),
    });
  }

  protected carregarUsuarios(): void {
    this.carregandoAcessos.set(true);

    this.acesso.listarUsuarios().subscribe({
      next: (usuarios) => {
        this.usuariosCadastrados.set(usuarios.map((u) => this.paraUsuarioSst(u)));
        this.carregandoAcessos.set(false);
      },
      error: (erro) => {
        this.carregandoAcessos.set(false);
        this.toastService.error(mensagemErroApi(erro));
      },
    });
  }

  private paraUsuarioSst(usuario: UsuarioApi): UsuarioSst {
    return {
      id: String(usuario.id),
      login: usuario.login,
      nomeCompleto: usuario.nomeCompleto,
      emailCorporativo: usuario.email,
      cpf: usuario.cpf,
      grupoId: String(usuario.grupoId),
      status: usuario.status === 'Ativo' ? 'ativo' : 'inativo',
    };
  }
}
