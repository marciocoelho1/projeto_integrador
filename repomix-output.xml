<file path="src/test/java/br/com/senac/sgsst/config/AuditoriaInterceptorTest.java">
package br.com.senac.sgsst.config;

import br.com.senac.sgsst.security.ContextoUsuario;
import br.com.senac.sgsst.security.UsuarioSessao;
import br.com.senac.sgsst.service.AuditoriaService;
import org.junit.jupiter.api.AfterEach;
import org.junit.jupiter.api.Test;
import org.springframework.mock.web.MockHttpServletRequest;
import org.springframework.mock.web.MockHttpServletResponse;

import java.util.Set;

import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;

class AuditoriaInterceptorTest {

  final AuditoriaService auditoria = mock(AuditoriaService.class);
  final AuditoriaInterceptor interceptor = new AuditoriaInterceptor(auditoria);

  @AfterEach void limparContexto() { ContextoUsuario.limpar(); }

  @Test void postEmApiRegistraCriacaoComStatusDaResposta() {
    var resposta = new MockHttpServletResponse();
    resposta.setStatus(201);

    interceptor.afterCompletion(
      requisicao("POST", "/api/colaboradores"), resposta, new Object(), null
    );

    verify(auditoria).registrar(
      null, null, "colaboradores", "CRIACAO",
      "POST /api/colaboradores (201)", "POST", "/api/colaboradores", 201
    );
  }

  @Test void putEDeleteMapeiamEdicaoEExclusao() {
    var requisicaoPut = requisicao("PUT", "/api/epis/5");
    interceptor.afterCompletion(requisicaoPut, new MockHttpServletResponse(), new Object(), null);

    interceptor.afterCompletion(
      requisicao("DELETE", "/api/epis/5"), new MockHttpServletResponse(), new Object(), null
    );

    verify(auditoria).registrar(
      null, null, "epis", "EDICAO",
      "PUT /api/epis/5 (200)", "PUT", "/api/epis/5", 200
    );
    verify(auditoria).registrar(
      null, null, "epis", "EXCLUSAO",
      "DELETE /api/epis/5 (200)", "DELETE", "/api/epis/5", 200
    );
  }

  @Test void usaUsuarioDaSessaoQuandoExiste() {
    ContextoUsuario.definir(new UsuarioSessao(
      3, "ana", "Ana Souza", "Administrador TST", Set.of()
    ));

    var resposta = new MockHttpServletResponse();
    resposta.setStatus(200);
    interceptor.afterCompletion(requisicao("POST", "/api/epis"), resposta, new Object(), null);

    verify(auditoria).registrar(
      3, "Ana Souza", "epis", "CRIACAO",
      "POST /api/epis (200)", "POST", "/api/epis", 200
    );
  }

  @Test void loginRegistraAcessoInclusiveComFalhaDeCredencial() {
    var sucesso = new MockHttpServletResponse();
    sucesso.setStatus(200);
    interceptor.afterCompletion(requisicao("POST", "/api/auth/login"), sucesso, new Object(), null);

    var falha = new MockHttpServletResponse();
    falha.setStatus(401);
    interceptor.afterCompletion(requisicao("POST", "/api/auth/login"), falha, new Object(), null);

    verify(auditoria).registrar(
      null, null, "auth", "ACESSO",
      "POST /api/auth/login (200)", "POST", "/api/auth/login", 200
    );
    verify(auditoria).registrar(
      null, null, "auth", "ACESSO",
      "POST /api/auth/login (401)", "POST", "/api/auth/login", 401
    );
  }

  @Test void getNaoRegistraAuditoria() {
    for (String caminho : new String[]{
      "/api/colaboradores",
      "/api/chamados",
      "/api/auditoria"
    }) {
      interceptor.afterCompletion(
        requisicao("GET", caminho), new MockHttpServletResponse(), new Object(), null
      );
    }

    verifyNoInteractions(auditoria);
  }

  @Test void healthENaoApiNaoRegistram() {
    interceptor.afterCompletion(
      requisicao("GET", "/api/health"), new MockHttpServletResponse(), new Object(), null
    );
    interceptor.afterCompletion(
      requisicao("POST", "/index.html"), new MockHttpServletResponse(), new Object(), null
    );

    verifyNoInteractions(auditoria);
  }

  @Test void falhaDoServicoDeAuditoriaNaoPropaga() {
    doThrow(new RuntimeException("banco indisponível"))
      .when(auditoria)
      .registrar(any(), any(), any(), any(), any(), any(), any(), anyInt());

    assertDoesNotThrow(() -> interceptor.afterCompletion(
      requisicao("POST", "/api/colaboradores"),
      new MockHttpServletResponse(),
      new Object(),
      null
    ));
  }

  private MockHttpServletRequest requisicao(String metodo, String caminho) {
    return new MockHttpServletRequest(metodo, caminho);
  }
}
</file>

<file path="src/test/java/br/com/senac/sgsst/dto/TreinamentoAvancadoValidationTest.java">
package br.com.senac.sgsst.dto;

import jakarta.validation.Validation;
import jakarta.validation.Validator;
import jakarta.validation.ValidatorFactory;
import org.junit.jupiter.api.AfterAll;
import org.junit.jupiter.api.Test;
import java.time.LocalDate;
import java.util.List;
import static org.junit.jupiter.api.Assertions.*;

/** Bean Validation dos itens 5 e 6 (vínculos, certificações, cargos/LNT e turmas de reciclagem). */
class TreinamentoAvancadoValidationTest {
  static final ValidatorFactory factory = Validation.buildDefaultValidatorFactory();
  static final Validator validator = factory.getValidator();
  static final LocalDate date = LocalDate.of(2026, 1, 1);
  @AfterAll static void close() { factory.close(); }

  @Test void vinculoNormalizaEspacosEAceitaOsTresStatus() {
    for (var status : List.of("Concluído", "Em Andamento", "Pendente")) {
      var request = new ColaboradorTreinamentoRequest(1, 2, date, "  " + status + "  ");
      assertTrue(validator.validate(request).isEmpty());
      assertEquals(status, request.status());
    }
  }

  @Test void vinculoAceitaDataDeConclusaoNula() {
    var request = new ColaboradorTreinamentoRequest(1, 2, null, "Pendente");
    assertTrue(validator.validate(request).isEmpty());
    assertNull(request.dataConclusao());
  }

  @Test void vinculoRejeitaIdsNulosStatusVazioEStatusForaDaLista() {
    assertEquals(2, validator.validate(new ColaboradorTreinamentoRequest(null, null, null, "Pendente")).size());
    assertEquals(1, validator.validate(new ColaboradorTreinamentoRequest(1, 2, date, "Cancelado")).size());
    assertEquals(2, validator.validate(new ColaboradorTreinamentoRequest(1, 2, date, " ")).size());
  }

  @Test void certificacaoRejeitaValidadeAnteriorAEmissao() {
    var request = new CertificacaoRequest(1, 2, "SENAC", "8 horas", date, date.minusDays(1), null);
    var violacoes = validator.validate(request);
    assertEquals(1, violacoes.size());
    assertEquals("validadePosteriorAEmissao", violacoes.iterator().next().getPropertyPath().toString());
    assertTrue(validator.validate(new CertificacaoRequest(1, 2, "SENAC", "8 horas", date, date, null)).isEmpty());
  }

  @Test void certificacaoNormalizaTextoEArquivoEmBranco() {
    var request = new CertificacaoRequest(1, 2, "  SENAC  ", " 8 horas ", date, date, "   ");
    assertTrue(validator.validate(request).isEmpty());
    assertEquals("SENAC", request.instituicao());
    assertEquals("8 horas", request.cargaHoraria());
    assertNull(request.arquivoUrl());
  }

  @Test void certificacaoRejeitaCamposObrigatoriosEmBranco() {
    var request = new CertificacaoRequest(null, null, " ", " ", null, null, null);
    assertEquals(6, validator.validate(request).size());
  }

  @Test void cargoRejeitaStatusForaDaListaETextosEmBranco() {
    assertTrue(validator.validate(new CargoRequest("Operador de Caixa", "Frente de Loja", "Ativo")).isEmpty());
    assertEquals(1, validator.validate(new CargoRequest("Operador de Caixa", "Frente de Loja", "Afastado")).size());
    assertEquals(4, validator.validate(new CargoRequest(" ", " ", " ")).size());
  }

  @Test void matrizDoCargoRejeitaListaNulaOuItemSemTreinamento() {
    assertEquals(1, validator.validate(new CargoTreinamentosRequest(null)).size());
    assertEquals(1, validator.validate(new CargoTreinamentosRequest(List.of(new CargoTreinamentoItemRequest(null, true)))).size());
    assertTrue(validator.validate(new CargoTreinamentosRequest(List.of(new CargoTreinamentoItemRequest(2, null)))).isEmpty());
  }

  @Test void matrizAssumeObrigatorioVerdadeiroQuandoNaoInformado() {
    assertTrue(new CargoTreinamentoItemRequest(2, null).obrigatorioEfetivo());
    assertFalse(new CargoTreinamentoItemRequest(2, false).obrigatorioEfetivo());
  }

  @Test void turmaRejeitaVagasNegativasStatusForaDaListaECamposVazios() {
    assertEquals(1, validator.validate(new TurmaReciclagemRequest(2, "Instrutor", date, -1, "Agendada")).size());
    assertEquals(1, validator.validate(new TurmaReciclagemRequest(2, "Instrutor", date, 0, "Planejada")).size());
    assertEquals(6, validator.validate(new TurmaReciclagemRequest(null, " ", null, null, " ")).size());
    assertTrue(validator.validate(new TurmaReciclagemRequest(2, " Instrutor ", date, 0, "Concluída")).isEmpty());
  }
}
</file>

<file path="src/test/java/br/com/senac/sgsst/security/AutenticacaoFilterTest.java">
package br.com.senac.sgsst.security;

import br.com.senac.sgsst.service.SessaoService;
import jakarta.servlet.FilterChain;
import org.junit.jupiter.api.AfterEach;
import org.junit.jupiter.api.Test;
import org.springframework.mock.web.MockHttpServletRequest;
import org.springframework.mock.web.MockHttpServletResponse;

import java.util.Optional;
import java.util.Set;
import java.util.concurrent.atomic.AtomicBoolean;
import java.util.concurrent.atomic.AtomicReference;

import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;

class AutenticacaoFilterTest {

  final SessaoService sessoes = mock(SessaoService.class);
  final AutenticacaoFilter filtro = new AutenticacaoFilter(sessoes);

  @AfterEach void limparContexto() {
    ContextoUsuario.limpar();
  }

  @Test void rotasLivresNaoExigemSessao() throws Exception {
    for (String caminho : new String[]{
      "/api/health",
      "/api/auth/login",
      "/api/auth/bootstrap",
      "/api/auth/recuperar-senha",
      "/api/auth/redefinir-senha"
    }) {
      var chamou = new AtomicBoolean(false);
      var resposta = new MockHttpServletResponse();

      filtro.doFilter(
        requisicao("GET", caminho, null),
        resposta,
        cadeia(chamou)
      );

      assertTrue(chamou.get(), caminho + " deveria passar");
      assertEquals(200, resposta.getStatus(), caminho);
    }

    verify(sessoes, never()).validar(any());
  }

  @Test void preflightEForaDaApiTambemPassam() throws Exception {
    var chamou = new AtomicBoolean(false);
    filtro.doFilter(
      requisicao("OPTIONS", "/api/colaboradores", null),
      new MockHttpServletResponse(),
      cadeia(chamou)
    );
    assertTrue(chamou.get());

    chamou.set(false);
    filtro.doFilter(
      requisicao("GET", "/index.html", null),
      new MockHttpServletResponse(),
      cadeia(chamou)
    );
    assertTrue(chamou.get());
  }

  @Test void semTokenRetorna401SemChamarACadeia() throws Exception {
    var chamou = new AtomicBoolean(false);
    var resposta = new MockHttpServletResponse();

    filtro.doFilter(requisicao("GET", "/api/colaboradores", null), resposta, cadeia(chamou));

    assertFalse(chamou.get());
    assertEquals(401, resposta.getStatus());
    assertTrue(resposta.getContentAsString().contains("Sessão ausente ou expirada"));
  }

  @Test void tokenInvalidoOuExpiradoRetorna401() throws Exception {
    when(sessoes.validar("expirado")).thenReturn(Optional.empty());

    var resposta = new MockHttpServletResponse();
    filtro.doFilter(
      requisicao("GET", "/api/colaboradores", "Bearer expirado"),
      resposta,
      cadeia(new AtomicBoolean(false))
    );

    assertEquals(401, resposta.getStatus());
    verify(sessoes).validar("expirado");
  }

  @Test void tokenValidoDisponibilizaSessaoDuranteAChamadaELimpraDepois() throws Exception {
    var sessao = new UsuarioSessao(1, "ana", "Ana Souza", "Administrador TST", Set.of("sgst_epis"));
    when(sessoes.validar("valido")).thenReturn(Optional.of(sessao));

    var durante = new AtomicReference<Optional<UsuarioSessao>>();
    var requisicao = requisicao("GET", "/api/colaboradores", "Bearer valido");

    filtro.doFilter(requisicao, new MockHttpServletResponse(), (req, res) -> {
      durante.set(ContextoUsuario.atual());
      assertSame(sessao, req.getAttribute("usuarioSessao"));
    });

    assertTrue(durante.get().isPresent());
    assertEquals("ana", durante.get().get().login());
    assertTrue(ContextoUsuario.atual().isEmpty(), "contexto deveria ser limpo no finally");
  }

  private MockHttpServletRequest requisicao(String metodo, String caminho, String autorizacao) {
    var requisicao = new MockHttpServletRequest(metodo, caminho);
    if (autorizacao != null) {
      requisicao.addHeader("Authorization", autorizacao);
    }
    return requisicao;
  }

  private FilterChain cadeia(AtomicBoolean chamou) {
    return (req, res) -> chamou.set(true);
  }
}
