# =====================================================================
# Template de variaveis de ambiente do backend SGSST
# =====================================================================
# Copie para .env e preencha, OU exporte no seu shell (~/.bashrc).
# O Spring Boot le estas variaveis via src/main/resources/application.properties.
#
# NUNCA versione o .env com valores reais.
# =====================================================================

# URL JDBC do PostgreSQL.
# Neon: converta postgresql:// -> jdbc:postgresql:// e mantenha ?sslmode=require
DB_URL=jdbc:postgresql://SEU_HOST.neon.tech/SEU_BANCO?sslmode=require

# Usuario do banco
DB_USERNAME=sgsst_owner

# Senha do banco (sem aspas)
DB_PASSWORD=

# Origens liberadas no CORS, separadas por virgula
CORS_ORIGINS=http://localhost:4200,https://sgsst-frontend-mvbu.onrender.com
