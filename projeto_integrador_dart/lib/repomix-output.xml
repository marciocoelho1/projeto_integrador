import '../models/certificacao.dart';
import '../models/reciclagem.dart';
import '../models/epi.dart';

class ServicoColaborador {

  // ==========================================================
  // BUSCAR CERTIFICAÇÕES
  // ==========================================================

  Future<List<Certificacao>>
      buscarCertificacoes() async {

    await Future.delayed(
      const Duration(milliseconds: 500),
    );

    return [
      Certificacao(
        treinamento:
            'NR-35 Trabalho em Altura',

        validade:
            '10/07/2026',

        concluida: true,
      ),
    ];
  }

  // ==========================================================
  // BUSCAR MATERIAIS DE RECICLAGEM
  // ==========================================================

  Future<List<Reciclagem>>
      buscarMateriaisReciclagem() async {

    await Future.delayed(
      const Duration(milliseconds: 500),
    );

    return [
      Reciclagem(
        titulo:
            'NR-35 Trabalho em Altura',

        prazo:
            '12/06/2026',

        enderecoMaterial:
            'https://exemplo.com/material',
      ),
    ];
  }

  // ==========================================================
  // BUSCAR EPIs
  // ==========================================================

  Future<List<Epi>>
      buscarEpis() async {

    await Future.delayed(
      const Duration(milliseconds: 500),
    );

    return [];
  }

  // ==========================================================
  // QUANTIDADE DE CERTIFICAÇÕES
  // ==========================================================

  Future<int> quantidadeCertificacoes() async {

    final certificacoes =
        await buscarCertificacoes();

    return certificacoes.length;
  }

  // ==========================================================
  // QUANTIDADE DE RECICLAGENS
  // ==========================================================

  Future<int> quantidadeReciclagens() async {

    final materiais =
        await buscarMateriaisReciclagem();

    return materiais.length;
  }

  // ==========================================================
  // QUANTIDADE DE EPIs
  // ==========================================================

  Future<int> quantidadeEpis() async {

    final epis =
        await buscarEpis();

    return epis.length;
  }
}
