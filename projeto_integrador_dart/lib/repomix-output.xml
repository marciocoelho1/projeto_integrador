class Epi {
  final int id;
  final String epi;
  final int quantidade;
  final String ca;
  final String dataEntrega;
  final bool termoAssinado;

Epi({
    required this.id,
    required this.epi,
    required this.quantidade,
    required this.ca,
    required this.dataEntrega,
    required this.termoAssinado,
  });

  factory Epi.fromJson(
    Map<String, dynamic> json,
  ) {
    return Epi(
      id: json['id'] ?? 0,
      epi: json['epi'] ?? '',
      quantidade: json['quantidade'] ?? 0,
      ca: json['ca'] ?? '',
      dataEntrega: json['dataEntrega'] ?? '',
      termoAssinado: json['termoAssinado'] ?? false,
    );
  }

  Map<String, dynamic> toJson() {
    return {
      'id': id,
      'epi': epi,
      'quantidade': quantidade,
      'ca': ca,
      'dataEntrega': dataEntrega,
      'termoAssinado': termoAssinado,
    };
  }
}
